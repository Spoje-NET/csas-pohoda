{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/multiflexi.app.schema.json",
  "schemaVersion": "3.4.0",
  "uuid": "5b9d6c3e-7a41-4c1e-9f6b-2d8e0a1c4f37",
  "name": {
    "en": "CSAS Statement to Pohoda Importer",
    "cs": "Import výpisů ČS do Pohody"
  },
  "description": {
    "en": "Downloads bank statements from Česká spořitelna (CSAS) in ABO format and imports the bank movements into Pohoda via mServer. Optionally uploads the statements (ABO and PDF) to SharePoint and attaches the PDF link to the bank records in Pohoda.",
    "cs": "Stáhne bankovní výpisy z České spořitelny ve formátu ABO a naimportuje bankovní pohyby do Pohody přes mServer. Volitelně nahraje výpisy (ABO a PDF) do SharePointu a připojí odkaz na PDF k bankovním záznamům v Pohodě."
  },
  "version": "0.3.0",
  "tags": [
    "banking",
    "accounting",
    "automation",
    "CSAS",
    "Pohoda"
  ],
  "homepage": "https://github.com/Spoje-NET/csas-pohoda",
  "executable": "/usr/bin/csas-pohoda",
  "requirements": [
    "Csas",
    "MServer"
  ],
  "events": {
    "emits": {
      "bank.statement.imported": {
        "description": "A bank statement was imported into the accounting system",
        "evidence": "banka",
        "operation": "create"
      }
    }
  },
  "produces": {
    "report": {
      "description": {
        "en": "Result of the download and the import",
        "cs": "Výsledek stažení a importu"
      },
      "schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/multiflexi.report.schema.json",
      "format": "json"
    }
  },
  "artifacts": [
    {
      "name": "CSAS Pohoda Report",
      "path": "${RESULT_FILE}",
      "type": "json",
      "description": {
        "en": "JSON report of the statement download and import.",
        "cs": "JSON report ze stažení a importu výpisů."
      }
    }
  ],
  "environment": {
    "FROM_DATE": {
      "type": "string",
      "description": {
        "en": "Start date YYYY-MM-DD (together with TO_DATE)",
        "cs": "Počáteční datum YYYY-MM-DD (spolu s TO_DATE)"
      },
      "required": false,
      "category": "Other",
      "hint": "2025-09-01"
    },
    "TO_DATE": {
      "type": "string",
      "description": {
        "en": "End date YYYY-MM-DD (together with FROM_DATE)",
        "cs": "Koncové datum YYYY-MM-DD (spolu s FROM_DATE)"
      },
      "required": false,
      "category": "Other",
      "hint": "2025-09-30"
    },
    "CSAS_STATEMENT_SCOPE": {
      "type": "string",
      "description": {
        "en": "Symbolic period used when no dates are given: today, yesterday, last_week, last_month, current_month ...",
        "cs": "Symbolické období, pokud nejsou zadána data"
      },
      "required": false,
      "category": "Other",
      "defval": "last_month"
    },
    "OUTPUT_DIR": {
      "type": "string",
      "description": {
        "en": "Directory where the downloaded statements are saved",
        "cs": "Adresář pro stažené výpisy"
      },
      "required": false,
      "category": "Other",
      "defval": "/var/tmp/csas-pohoda"
    },
    "POHODA_BANK_IDS": {
      "type": "string",
      "description": {
        "en": "Bank account identifier (ID) of the CSAS account in Pohoda",
        "cs": "Zkratka bankovního účtu ČS v Pohodě"
      },
      "required": true,
      "category": "Other",
      "hint": "CS"
    },
    "POHODA_TIMEOUT": {
      "type": "integer",
      "description": {
        "en": "mServer connection timeout in seconds",
        "cs": "Timeout spojení s mServerem v sekundách"
      },
      "required": false,
      "category": "Other",
      "defval": "60"
    },
    "POHODA_DEBUG": {
      "type": "bool",
      "description": {
        "en": "Enable mServer debug output",
        "cs": "Ladicí výstup mServeru"
      },
      "required": false,
      "category": "Other",
      "defval": "false"
    },
    "RESULT_FILE": {
      "type": "string",
      "description": {
        "en": "Write the JSON report to this file",
        "cs": "Soubor pro JSON report"
      },
      "required": false,
      "category": "Other",
      "defval": "csas_pohoda.json"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "Log destinations: console|syslog",
        "cs": "Cíle logu: console|syslog"
      },
      "required": false,
      "category": "Other",
      "defval": "console|syslog"
    },
    "POHODA_BANK_CODE": {
      "type": "string",
      "description": {
        "en": "Bank code of the account, 0800 for Česká spořitelna",
        "cs": "Kód banky účtu, 0800 pro Českou spořitelnu"
      },
      "required": true,
      "defval": "0800",
      "category": "Other"
    },
    "OFFICE365_TENANT": {
      "type": "text",
      "description": {
        "en": "SharePoint tenant (Graph, Entra ID app-only); leave empty to skip SharePoint",
        "cs": "Tenant SharePointu (Graph, Entra ID); prázdné = bez SharePointu"
      },
      "required": false,
      "category": "Other",
      "defval": ""
    },
    "OFFICE365_SITE": {
      "type": "text",
      "description": {
        "en": "SharePoint site",
        "cs": "Site SharePointu"
      },
      "required": false,
      "category": "Other",
      "defval": ""
    },
    "OFFICE365_CLIENTID": {
      "type": "text",
      "description": {
        "en": "Entra ID application (client) ID",
        "cs": "Client ID aplikace Entra ID"
      },
      "required": false,
      "category": "Other",
      "defval": ""
    },
    "OFFICE365_CLSECRET": {
      "type": "password",
      "description": {
        "en": "Entra ID client secret",
        "cs": "Client Secret aplikace Entra ID"
      },
      "required": false,
      "category": "Security",
      "defval": ""
    },
    "OFFICE365_PATH": {
      "type": "text",
      "description": {
        "en": "SharePoint folder for PDF statements",
        "cs": "Složka SharePointu pro PDF výpisy"
      },
      "required": false,
      "category": "Other",
      "defval": "",
      "hint": "Shared Documents/Bank/PDF"
    },
    "OFFICE365_PATH_ABO": {
      "type": "text",
      "description": {
        "en": "SharePoint folder for ABO statements, empty = same as OFFICE365_PATH",
        "cs": "Složka SharePointu pro ABO výpisy, prázdné = jako OFFICE365_PATH"
      },
      "required": false,
      "category": "Other",
      "defval": ""
    },
    "SHAREPOINT_PERMANENT_LINK": {
      "type": "bool",
      "description": {
        "en": "Store a permanent sharing link instead of the path based URL",
        "cs": "Ukládat trvalý sdílený odkaz místo URL závislé na cestě"
      },
      "required": false,
      "category": "Other",
      "defval": true
    },
    "SHAREPOINT_LINK_TYPE": {
      "type": "set",
      "description": {
        "en": "Type of the SharePoint sharing link",
        "cs": "Typ sdíleného odkazu SharePoint"
      },
      "required": false,
      "category": "Other",
      "defval": "view",
      "options": {
        "view": "View (read-only)",
        "edit": "Edit"
      }
    },
    "SHAREPOINT_LINK_SCOPE": {
      "type": "set",
      "description": {
        "en": "Who the SharePoint sharing link works for",
        "cs": "Pro koho sdílený odkaz platí"
      },
      "required": false,
      "category": "Other",
      "defval": "organization",
      "options": {
        "anonymous": "Anonymous",
        "organization": "Organization",
        "users": "Users"
      }
    },
    "DB_CONNECTION": {
      "type": "text",
      "description": {
        "en": "Pohoda SQL Server connection type",
        "cs": "Typ připojení k SQL serveru Pohody"
      },
      "required": false,
      "category": "Database",
      "defval": "sqlsrv"
    },
    "DB_HOST": {
      "type": "text",
      "description": {
        "en": "Pohoda SQL Server host; with SharePoint it enables attaching the statement links to bank records",
        "cs": "Hostitel SQL serveru Pohody; spolu se SharePointem zapne přílohy odkazů u bankovních záznamů"
      },
      "required": false,
      "category": "Database",
      "defval": ""
    },
    "DB_PORT": {
      "type": "integer",
      "description": {
        "en": "Pohoda SQL Server port",
        "cs": "Port SQL serveru Pohody"
      },
      "required": false,
      "category": "Database",
      "defval": 1433
    },
    "DB_DATABASE": {
      "type": "text",
      "description": {
        "en": "Pohoda database name",
        "cs": "Název databáze Pohody"
      },
      "required": false,
      "category": "Database",
      "defval": "",
      "hint": "StwPh_12345678_2026"
    },
    "DB_USERNAME": {
      "type": "text",
      "description": {
        "en": "Database username",
        "cs": "Uživatel databáze"
      },
      "required": false,
      "category": "Database",
      "defval": ""
    },
    "DB_PASSWORD": {
      "type": "password",
      "description": {
        "en": "Database password",
        "cs": "Heslo databáze"
      },
      "required": false,
      "category": "Security",
      "defval": ""
    }
  }
}
